{
  "name": "wayfound",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && tsc --noEmit",
    "local:refresh": "node scripts/wayfound-local-test.mjs refresh",
    "local:start": "node scripts/wayfound-local-test.mjs start",
    "local:status": "node scripts/wayfound-local-test.mjs status",
    "local:stop": "node scripts/wayfound-local-test.mjs stop",
    "local:reset": "node scripts/wayfound-local-test.mjs reset",
    "test:local-test-package": "node scripts/validate-local-test-package.mjs",
    "test:prototype": "node scripts/validate-prototype.mjs",
    "test:accessibility": "node scripts/validate-accessibility.mjs",
    "test:guided-ui": "node scripts/validate-guided-ui.mjs",
    "test:single-user-mode": "node scripts/validate-single-user-mode.mjs",
    "test:ai-dev-console": "node scripts/validate-ai-development-console.mjs",
    "test:local-ai-connection": "node scripts/validate-local-ai-connection.mjs && npm run test:ai-dev-console",
    "test:workspace": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-workspace.mjs",
    "test:criterion-withdrawal": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-criterion-withdrawal.mjs",
    "test:multiple-criteria": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-multiple-criteria.mjs && npm run test:criterion-withdrawal",
    "test:evidence": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-evidence.mjs",
    "test:artifacts": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-artifacts.mjs",
    "test:artifact-acceptance": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-artifact-acceptance.mjs",
    "test:work-lifecycle": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-work-lifecycle.mjs",
    "test:work-completion": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-work-completion.mjs",
    "test:ai-review": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-ai-review.mjs && WAYFOUND_LOCAL_TEST=1 node scripts/validate-ai-development-console-browser.mjs && WAYFOUND_LOCAL_TEST=1 node scripts/validate-ai-development-console-openai.mjs",
    "test:work-dependencies": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-work-dependencies.mjs",
    "test:work-direction-links": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-work-direction-links.mjs",
    "test:specialist-review": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-specialist-review.mjs",
    "test:technical-decisions": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-technical-decisions.mjs",
    "test:technical-requirements": "WAYFOUND_LOCAL_TEST=1 node scripts/validate-technical-requirements.mjs",
    "seed:local": "WAYFOUND_LOCAL_TEST=1 node scripts/seed-local.mjs",
    "seed:single-user-local": "WAYFOUND_LOCAL_TEST=1 node scripts/seed-single-user-local.mjs",
    "test:workspace-ui": "node scripts/validate-workspace-ui.mjs",
    "test:workspace-guidance": "node scripts/validate-workspace-guidance.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.16.3",
    "playwright": "1.55.0",
    "postcss": "8.5.28",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
