# Isolated development Supabase instance. No service key in the application.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:3000

# ADR-0005: set true for the active single-human + AI first-version experience.
WAYFOUND_SINGLE_USER_MODE=false

# ADR-0006: optional local-test convenience. All guards must pass before automatic owner authentication is allowed.
WAYFOUND_SINGLE_USER_AUTO_SIGN_IN=false
WAYFOUND_LOCAL_TEST=0
WAYFOUND_SINGLE_USER_OWNER_EMAIL=
WAYFOUND_SINGLE_USER_OWNER_PASSWORD=

# ADR-0007: temporary development AI traffic console. Requires single-user mode + local-test mode + loopback APP_ORIGIN.
WAYFOUND_AI_DEV_CONSOLE=false

# Local AI endpoints. Direct host development can use the defaults below.
# Docker Desktop packaging can change these to host.docker.internal on the same fixed ports.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Explicit public-provider development testing. Keep this secret out of Git.
OPENAI_API_KEY=
