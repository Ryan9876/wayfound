# Wayfound defaults to local-first operation. No cloud account is required.
WAYFOUND_IDENTITY_MODE=local
WAYFOUND_PERSISTENCE_MODE=local

# Optional. Defaults to ~/.wayfound/wayfound.sqlite.
# WAYFOUND_LOCAL_DB=/absolute/path/to/wayfound.sqlite

# AI is off unless explicitly enabled.
WAYFOUND_AI_PROVIDER=off
# WAYFOUND_AI_MODEL=

# Local Ollama example:
# WAYFOUND_AI_PROVIDER=ollama
# WAYFOUND_AI_MODEL=qwen3-coder:30b
# WAYFOUND_AI_BASE_URL=http://127.0.0.1:11434/v1

# Local LM Studio example:
# WAYFOUND_AI_PROVIDER=lmstudio
# WAYFOUND_AI_MODEL=<model-id-from-lm-studio>
# WAYFOUND_AI_BASE_URL=http://127.0.0.1:1234/v1

# External OpenAI-compatible provider. External project-content transfer is blocked
# unless WAYFOUND_ALLOW_EXTERNAL_AI=true is set deliberately.
# WAYFOUND_AI_PROVIDER=openai-compatible
# WAYFOUND_AI_BASE_URL=https://api.openai.com/v1
# WAYFOUND_AI_MODEL=<model-id>
# WAYFOUND_AI_API_KEY=<store-locally; never commit>
# WAYFOUND_ALLOW_EXTERNAL_AI=true

# Optional hosted mode adapters. These are NOT required for local Wayfound.
# WAYFOUND_IDENTITY_MODE=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# WAYFOUND_PERSISTENCE_MODE=postgres
# DATABASE_URL=
# WAYFOUND_DATA_ENV=development
